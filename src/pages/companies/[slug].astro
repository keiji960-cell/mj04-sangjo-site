---
import Layout from '../../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const companies = await getCollection('companies');
  return companies.map((c) => ({
    params: { slug: c.id.replace(/\.json$/, '') },
    props: { company: c },
  }));
}

interface Props {
  company: CollectionEntry<'companies'>;
}

const { company } = Astro.props;
const c = company.data;

const fmtWon = (n: number | null) => (n === null ? '정보 없음' : `${n.toLocaleString('ko-KR')}원`);
const fmtPct = (n: number | null) => (n === null ? '정보 없음' : `${n}%`);

const badgeClass =
  c.finance.capitalStatus === '완전자본잠식' ? 'badge-full' : c.finance.capitalStatus === '부분자본잠식' ? 'badge-partial' : 'badge-normal';
---
<Layout title={`${c.name} — 등록·재무 정보`} description={`공정거래위원회 공시 기준 ${c.name}의 등록정보, 재무현황, 선수금현황.`}>
  <article>
    <p class="article-meta">공정거래위원회 공시 기준 · 조회일 {c.source.asOfDate}</p>
    <h1>{c.name}</h1>
    <p><span class={`badge ${badgeClass}`}>{c.finance.capitalStatus}</span></p>

    <h2>등록 정보</h2>
    <table>
      <tbody>
        <tr><th>등록번호</th><td>{c.regNumber}</td></tr>
        <tr><th>등록일</th><td>{c.regDate ?? '정보 없음'}</td></tr>
        <tr><th>영업 상태</th><td>{c.status}</td></tr>
        <tr><th>영업개시일</th><td>{c.businessStartDate ?? '정보 없음'}</td></tr>
        <tr><th>법인 소재지</th><td>{c.corpAddress ?? '정보 없음'}</td></tr>
        <tr><th>전화번호</th><td>{c.phone ?? '정보 없음'}</td></tr>
      </tbody>
    </table>

    <h2>재무 현황</h2>
    <p class="disclaimer">아래 수치는 공정위 공시를 그대로 옮긴 것이며, 자본잠식 상태는 <code>자본총계 = 자산총계 − 부채총계</code> 계산에 근거한 회계상 분류입니다.</p>
    <table>
      <tbody>
        <tr><th>자산총계</th><td>{fmtWon(c.finance.totalAssets)}</td></tr>
        <tr><th>부채총계</th><td>{fmtWon(c.finance.totalLiabilities)}</td></tr>
        <tr><th>자본총계</th><td>{fmtWon(c.finance.totalEquity)}</td></tr>
        <tr><th>자본금</th><td>{fmtWon(c.finance.capital)}</td></tr>
        <tr><th>부채비율(해당업체 / 업계 평균)</th><td>{fmtPct(c.finance.debtRatioCompany)} / {fmtPct(c.finance.debtRatioAverage)}</td></tr>
      </tbody>
    </table>

    <h2>선수금 현황</h2>
    <table>
      <tbody>
        <tr><th>총선수금</th><td>{fmtWon(c.prepayment.totalPrepayment)}</td></tr>
        <tr><th>보전비율</th><td>{fmtPct(c.prepayment.guaranteeRatio)}</td></tr>
        <tr><th>보전 계약기관</th><td>{c.prepayment.guaranteeInstitution ?? '정보 없음'} ({c.prepayment.guaranteeType ?? '-'})</td></tr>
        <tr><th>보전금액</th><td>{fmtWon(c.prepayment.guaranteeAmount)}</td></tr>
      </tbody>
    </table>

    <p class="disclaimer">
      원본 출처: <a href={c.source.url} target="_blank" rel="noopener">{c.source.name}</a> ({c.source.asOfDate} 조회). 이 페이지는 투자·법률 자문이 아니며 정보 제공 목적입니다. 오류를 발견하셨다면 <a href="mailto:keiji960+mj04@gmail.com">keiji960+mj04@gmail.com</a>으로 알려주세요.
    </p>
    <p><a href="/companies/">← 전체 업체 비교표로 돌아가기</a></p>
  </article>
</Layout>
